# Auto detect text files and perform LF normalization
* text=auto

# Keep Android source checksums stable on Windows and Linux.
android/**/*.java text eol=lf
android/**/*.xml text eol=lf
*.apk binary

android-management/**/*.java text eol=lf
android-management/**/*.xml text eol=lf
android-support/**/*.java text eol=lf
android-support/**/*.xml text eol=lf
mobile-android/**/*.java text eol=lf
mobile-android/**/*.xml text eol=lf
